// doctor.odin - System health check and diagnostics using arena allocation
//
// Provides comprehensive diagnostics for wayu configuration,
// shell setup, and common issues.
// Uses arena allocator for simple memory management.

package wayu
import "core:fmt"
import "core:os"
import "core:strings"
import "core:mem"
import "core:mem/virtual"
// Check result structure - all strings allocated from arena
CheckResult :: struct {
	name:    string,
	status:  CheckStatus,
	message: string,
	fixable: bool,
}

CheckStatus :: enum {
	OK,
	WARNING,
	ERROR,
	INFO,
}

// Arena for doctor allocations. A growing virtual-memory arena: the previous
// fixed 64KB buffer was exhausted by a large wayu.toml (or by --fix, which
// re-runs every check), and the resulting allocation failures surfaced as
// bogus "cannot read" errors.
doctor_arena: virtual.Arena
doctor_arena_ready: bool

// Get arena allocator - arena must be initialized first
get_doctor_allocator :: proc() -> mem.Allocator {
	ensure_arena_initialized()
	return virtual.arena_allocator(&doctor_arena)
}

// Ensure arena is initialized
ensure_arena_initialized :: proc() {
	if !doctor_arena_ready {
		if err := virtual.arena_init_growing(&doctor_arena); err == nil {
			doctor_arena_ready = true
		}
	}
}

// Main doctor command handler.
//
// Exit status: EXIT_SUCCESS when no check reports an error (after --fix's
// re-check), EXIT_CONFIG otherwise, so doctor can gate CI and scripts.
handle_doctor_command :: proc(fix_mode: bool, json_output: bool, profile_mode: bool = false, optimize_mode: bool = false) {
	if optimize_mode {
		// The init files are generated by wayu and rewritten on every
		// config change; a hand-written "optimized" init double-sourced
		// tools/extra and was silently reverted by the next write.
		print_error("'wayu doctor --optimize' was removed: wayu already generates an optimized init (`wayu build`); use `wayu export` for a single-file turbo init")
		os.exit(EXIT_USAGE)
	}

	// Profile mode: write the startup profiler script; no checks needed.
	if profile_mode {
		run_shell_profile()
		return
	}

	if fix_mode && json_output {
		print_error("--json reports only; it cannot be combined with --fix")
		os.exit(EXIT_USAGE)
	}

	// --fix rewrites wayu.toml (drops PATH entries), so it follows the same
	// confirmation rule as `wayu path clean`.
	if fix_mode && !wayu.dry_run && !wayu.yes_flag {
		print_error("doctor --fix removes missing/duplicate PATH entries from wayu.toml. Pass --yes to confirm, or --dry-run to preview.")
		os.exit(EXIT_USAGE)
	}

	ensure_arena_initialized()
	arena_alloc := get_doctor_allocator()
	context.allocator = arena_alloc

	results := make([dynamic]CheckResult)
	run_all_checks(&results)

	if json_output {
		print_doctor_json(results[:])
		doctor_exit(results[:])
	}

	print_header("wayu Doctor - System Health Check", "🔬")
	fmt.println()
	print_doctor_results(results[:])

	// Fix mode: attempt to fix issues, then re-run checks
	fix_attempts: []FixAttempt
	if fix_mode {
		fmt.println()
		print_section("Auto-fix", "🔧")
		fix_attempts = attempt_auto_fixes(results[:], arena_alloc)
		fmt.println()

		print_section("Re-checking", "🔄")
		fmt.println()
		clear(&results)
		run_all_checks(&results)
		print_doctor_results(results[:])
	}

	print_doctor_summary(results[:], fix_mode, fix_attempts)
	doctor_exit(results[:])
}

// Exit EXIT_CONFIG when any check is an error, EXIT_SUCCESS otherwise.
doctor_exit :: proc(results: []CheckResult) -> ! {
	for r in results {
		if r.status == .ERROR { os.exit(EXIT_CONFIG) }
	}
	os.exit(EXIT_SUCCESS)
}

// Run all diagnostic checks.
//
// Iterates the `CHECKS` registry defined in doctor_checks.odin rather than
// hard-coding the call sequence. This decouples the presentation layer from
// the checks themselves and provides a hook for future selective modes such
// as `wayu doctor --check=plugins`.
run_all_checks :: proc(results: ^[dynamic]CheckResult) {
	for check in CHECKS {
		check.fn(results)
	}
}

// Helper to clone string to arena
clone_arena :: proc(s: string) -> string {
	ensure_arena_initialized()
	return strings.clone(s, get_doctor_allocator())
}

// Individual check procs (check_wayu_installation, check_shell_config,
// check_path_entries, check_plugins, check_backups, check_toml_config,
// check_turbo_export, check_dependencies, check_command_exists, check_sync_status)
// and the shell-RC helper `get_shell_rc_file_arena` were extracted to
// src/doctor_checks.odin (2026-04-24, code review L3). The presentation,
// orchestration, arena plumbing, and auto-fix logic stay in this file.

// Print doctor results
print_doctor_results :: proc(results: []CheckResult) {
	for result in results {
		status_icon := ""
		status_color := ""

		switch result.status {
		case .OK:
			status_icon = "✓"
			status_color = get_success()
		case .WARNING:
			status_icon = "⚠"
			status_color = get_warning()
		case .ERROR:
			status_icon = "✗"
			status_color = get_error()
		case .INFO:
			status_icon = "ℹ"
			status_color = get_muted()
		}

		fixable_icon := ""
		if result.fixable {
			fixable_icon = " 🔧"
		}

		fmt.printfln("  %s%s%s %s%s", status_color, status_icon, RESET, result.name, fixable_icon)
		fmt.printfln("    %s%s%s", get_muted(), result.message, RESET)
	}
	fmt.println()
}

// Print doctor summary
print_doctor_summary :: proc(results: []CheckResult, fix_mode: bool = false, fix_attempts: []FixAttempt = {}) {
	ok_count := 0
	warning_count := 0
	error_count := 0
	info_count := 0
	fixable_count := 0

	for result in results {
		switch result.status {
		case .OK:
			ok_count += 1
		case .WARNING:
			warning_count += 1
		case .ERROR:
			error_count += 1
		case .INFO:
			info_count += 1
		}

		if result.fixable {
			fixable_count += 1
		}
	}

	print_section("Summary", EMOJI_INFO)

	// Proper singular/plural formatting
	warning_word := "warning"
	if warning_count != 1 {
		warning_word = "warnings"
	}
	error_word := "error"
	if error_count != 1 {
		error_word = "errors"
	}
	info_word := "info"
	if info_count != 1 {
		info_word = "infos"
	}

	fmt.printfln("  %s%d OK%s  %s%d %s%s  %s%d %s%s  %d %s",
		get_success(), ok_count, RESET,
		get_warning(), warning_count, warning_word, RESET,
		get_error(), error_count, error_word, RESET,
		info_count, info_word)
	fmt.println()

	if error_count > 0 {
		error_label := "error"
		if error_count != 1 {
			error_label = "errors"
		}
		fmt.printfln("  %s✗ Found %d %s that need attention%s", get_error(), error_count, error_label, RESET)
	}

	if warning_count > 0 {
		warning_label := "warning"
		if warning_count != 1 {
			warning_label = "warnings"
		}
		fmt.printfln("  %s⚠ Found %d %s to review%s", get_warning(), warning_count, warning_label, RESET)
	}

	if fixable_count > 0 && !fix_mode {
		fixable_label := "issue"
		if fixable_count != 1 {
			fixable_label = "issues"
		}
		fmt.printfln("  %s🔧 %d %s can be auto-fixed%s", get_primary(), fixable_count, fixable_label, RESET)
		fmt.println()
		fmt.println("  Run with --fix to attempt automatic fixes:")
		fmt.println("    wayu doctor --fix --dry-run   # preview")
		fmt.println("    wayu doctor --fix --yes       # apply")
	}

	// Show fix results after attempting fixes
	if fix_mode && len(fix_attempts) > 0 {
		success_count := 0
		failed_count := 0
		for attempt in fix_attempts {
			if attempt.success {
				success_count += 1
			} else {
				failed_count += 1
			}
		}

		if failed_count > 0 {
			fail_word := "fix"
			if failed_count != 1 {
				fail_word = "fixes"
			}
			fmt.printfln("  %s⚠ %d %s failed and require manual action%s",
				get_warning(), failed_count, fail_word, RESET)
			fmt.println()
			fmt.println("  Manual fixes needed:")
			for attempt in fix_attempts {
				if !attempt.success {
					fmt.printfln("    • %s: %s", attempt.name, attempt.message)
				}
			}
		}

		if success_count > 0 {
			success_word := "fix"
			if success_count != 1 {
				success_word = "fixes"
			}
			if wayu.dry_run {
				fmt.printfln("  %s%d %s previewed (dry run — nothing changed)%s",
					get_muted(), success_count, success_word, RESET)
			} else {
				fmt.printfln("  %s✓ %d %s applied successfully%s",
					get_success(), success_count, success_word, RESET)
			}
		}
	}

	if error_count == 0 && warning_count == 0 {
		fmt.printfln("  %s✓ All checks passed!%s", get_success(), RESET)
	}

	fmt.println()
}

// Fix attempt result
FixAttempt :: struct {
	name:    string,
	success: bool,
	message: string,
}

// Attempt to auto-fix issues - returns list of fix attempts
attempt_auto_fixes :: proc(results: []CheckResult, arena_alloc: mem.Allocator) -> []FixAttempt {
	attempts := make([dynamic]FixAttempt, allocator = arena_alloc)

	for result in results {
		if !result.fixable {
			continue
		}

		switch result.name {
		case "PATH entries":
			fmt.printfln("  %s• Cleaning wayu.toml [paths] (missing + duplicate entries)...%s", get_primary(), RESET)

			_, fix_ok, fix_msg := doctor_fix_toml_paths(arena_alloc)
			if fix_ok {
				fmt.printfln("    %s✓ %s%s", get_success(), fix_msg, RESET)
			} else {
				fmt.printfln("    %s✗ %s%s", get_error(), fix_msg, RESET)
			}
			append(&attempts, FixAttempt{
				name    = result.name,
				success = fix_ok,
				message = fix_msg,
			})

		case:
			fmt.printfln("  %s• Cannot auto-fix: %s%s", get_muted(), result.name, RESET)
		}
	}

	return attempts[:]
}

// Print doctor results as JSON
print_doctor_json :: proc(results: []CheckResult) {
	builder: strings.Builder
	strings.builder_init(&builder)
	defer strings.builder_destroy(&builder)

	strings.write_string(&builder, "{\n")
	strings.write_string(&builder, `  "checks": [`)
	strings.write_string(&builder, "\n")

	for result, i in results {
		status_str := ""
		switch result.status {
		case .OK:      status_str = "ok"
		case .WARNING: status_str = "warning"
		case .ERROR:   status_str = "error"
		case .INFO:    status_str = "info"
		}

		comma := ","
		if i == len(results) - 1 {
			comma = ""
		}

		// Build the JSON object manually
		strings.write_string(&builder, `    {`)
		strings.write_string(&builder, `"name": "`)
		strings.write_string(&builder, json_escape(result.name))
		fmt.sbprintf(&builder, `", "status": "%s", "message": "`, status_str)
		strings.write_string(&builder, json_escape(result.message))
		fmt.sbprintf(&builder, `", "fixable": %v}`, result.fixable)
		strings.write_string(&builder, comma)
		strings.write_string(&builder, "\n")
	}

	strings.write_string(&builder, "  ],\n")

	// Count summary
	ok_count := 0
	warning_count := 0
	error_count := 0
	info_count := 0
	fixable_count := 0

	for result in results {
		switch result.status {
		case .OK:      ok_count += 1
		case .WARNING: warning_count += 1
		case .ERROR:   error_count += 1
		case .INFO:    info_count += 1
		}
		if result.fixable {
			fixable_count += 1
		}
	}

	strings.write_string(&builder, `  "summary": {`)
	fmt.sbprintf(&builder, `"ok": %d, "warnings": %d, "errors": %d, "info": %d, "fixable": %d`,
		ok_count, warning_count, error_count, info_count, fixable_count)
	strings.write_string(&builder, "}\n")
	strings.write_string(&builder, "}\n")

	// Output the built string
	fmt.print(strings.to_string(builder))
}

// Print doctor usage
print_doctor_usage :: proc() {
	fmt.println()
	fmt.printfln("%swayu doctor - System health check and diagnostics%s", BOLD, RESET)
	fmt.println()
	fmt.printfln("%sUSAGE:%s", get_primary(), RESET)
	fmt.printfln("  wayu doctor              Run all health checks")
	fmt.printfln("  wayu doctor --fix --yes  Remove missing/duplicate PATH entries from wayu.toml")
	fmt.printfln("  wayu doctor --fix -n     Preview what --fix would change (dry run)")
	fmt.printfln("  wayu doctor --json       Output results as JSON")
	fmt.printfln("  wayu doctor --profile    Profile shell startup performance")
	fmt.println()
	fmt.printfln("%sEXIT STATUS:%s", get_primary(), RESET)
	fmt.println("  0 when no check reports an error, 78 (EXIT_CONFIG) otherwise")
	fmt.println()
	fmt.printfln("%sDESCRIPTION:%s", get_primary(), RESET)
	fmt.println("  Diagnoses wayu installation, shell configuration, PATH entries,")
	fmt.println("  plugins, backups, and other common issues.")
	fmt.println()
	fmt.printfln("%sCHECKS PERFORMED:%s", get_primary(), RESET)
	fmt.println("  • wayu installation and version")
	fmt.println("  • Shell RC file configuration")
	fmt.println("  • bash: PROMPT_COMMAND not replaced after wayu is loaded")
	fmt.println("  • PATH entries (missing directories, duplicates)")
	fmt.println("  • Plugin status")
	fmt.println("  • Backup system")
	fmt.println("  • TOML configuration validity")
	fmt.println("  • Turbo export status")
	fmt.println("  • Required dependencies (git, zsh)")
	fmt.println()
	fmt.printfln("  %s--profile%s     Measure shell startup performance", get_primary(), RESET)
}

// Run shell startup profiling
run_shell_profile :: proc() {
	print_header("Shell Startup Profiler", "⏱️ ")
	fmt.println()

	fmt.println("Generating profile script...")

	profile_script := `#!/usr/bin/env zsh
# Shell Startup Profiler - Generated by wayu
zmodload zsh/zprof 2>/dev/null || true

typeset -F SECONDS=0
start_time=$EPOCHREALTIME

echo "🔍 Profiling shell startup..."
echo ""

times=()
labels=()

run_step() {
  local label=$1
  shift
  local step_start=$EPOCHREALTIME
  "$@" 2>/dev/null
  local elapsed=$(($EPOCHREALTIME - $step_start))
  times+=($elapsed)
  labels+=($label)
  printf "  %-30s %6.3fs\n" $label $elapsed
}

echo "=== Phase 1: Core Config ==="
# Post-migration: core.zsh is the compiled source of truth.
# Legacy per-type files are fallback-only.
run_step "core.zsh" source "$HOME/.config/wayu/core.zsh" 2>/dev/null || true
run_step "constants.zsh (legacy)" source "$HOME/.config/wayu/constants.zsh" 2>/dev/null || true
run_step "path.zsh (legacy)" source "$HOME/.config/wayu/path.zsh" 2>/dev/null || true

echo ""
echo "=== Phase 2: Functions ==="
run_step "functions (glob)" zsh -c 'for f in "$HOME/.config/wayu/functions"/*(N); do [[ -f "$f" ]] && source "$f"; done'

echo ""
echo "=== Phase 3: Completions Setup ==="
run_step "fpath setup" zsh -c 'fpath=("$HOME/.config/wayu/completions" $fpath)'
run_step "compinit" autoload -Uz compinit && compinit -C

echo ""
echo "=== Phase 4: Plugins ==="
run_step "autosuggestions" source "$HOME/.config/wayu/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" 2>/dev/null || true
run_step "syntax-highlighting" source "$HOME/.config/wayu/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" 2>/dev/null || true
run_step "plugin config" source "$HOME/.config/wayu/plugins/config.zsh" 2>/dev/null || true

echo ""
echo "=== Phase 5: Aliases & Tools ==="
run_step "aliases.zsh (legacy)" source "$HOME/.config/wayu/aliases.zsh" 2>/dev/null || true
run_step "tools.zsh" source "$HOME/.config/wayu/tools.zsh" 2>/dev/null || true

echo ""
echo "=== Phase 6: Extra Config ==="
run_step "extra.zsh" source "$HOME/.config/wayu/extra.zsh" 2>/dev/null || true

total=$(($EPOCHREALTIME - start_time))

echo ""
echo "📊 SUMMARY"
echo "  Total startup time: ${total}s"
echo ""
echo "  Top 5 slowest components:"

# Sort and display top 5
for i in {1..${#times}}; do
  echo "${times[$i]} ${labels[$i]}"
done | sort -rn | head -5 | while read time label; do
  printf "    %-30s %6.3fs\n" $label $time
done

echo ""
echo "💡 OPTIMIZATION TIPS:"
if (( ${times[(I)compinit]} > 0.05 )); then
  echo "  • compinit is slow (>50ms). Run 'compinit -C' to use cache."
fi
if (( ${times[(I)extra.zsh]} > 0.3 )); then
  echo "  • extra.zsh is slow (>300ms). Check for Conda/Python initialization."
fi
if (( ${times[(I)syntax-highlighting]} > 0.1 )); then
  echo "  • syntax-highlighting adds latency. Consider deferring it."
fi
echo "  • Use 'wayu export' for turbo mode (~2-4x faster)"
`

	script_path := fmt.aprintf("%s/startup_profile.zsh", wayu.data)
	defer delete(script_path)

	write_ok := os.write_entire_file_from_string(script_path, profile_script)
	if write_ok != nil {
		print_error("Failed to write profile script")
		return
	}

	fmt.printfln("%s✓%s Profile script created: %s", get_success(), RESET, script_path)
	fmt.println()
	fmt.println("Run this command to profile your shell startup:")
	fmt.println()
	fmt.printfln("  %szsh %s%s", get_primary(), script_path, RESET)
	fmt.println()
	fmt.println("Or for a quick measurement:")
	fmt.println()
	fmt.printfln("  %stime zsh -i -c exit%s", get_primary(), RESET)
	fmt.println()
	fmt.println()
	fmt.println("🚀 Optimization options:")
	fmt.println(`  wayu export              Generate turbo.zsh (2-4x faster)`)
}

// Signature every doctor check must implement.
CheckFn :: proc(results: ^[dynamic]CheckResult)

// Registered check with a stable short name. Names are snake-case-free ASCII
// so they fit cleanly into a future `--check=<name>` CLI flag.
CheckEntry :: struct {
	name: string,
	fn:   CheckFn,
}

// All registered checks. `run_all_checks` iterates this in order.
// Order mirrors the original hard-coded sequence from pre-refactor doctor.odin
// so output stays byte-stable for users.
CHECKS := []CheckEntry{
	{"installation", check_wayu_installation},
	{"shell",        check_shell_config},
	{"promptcmd",    check_bash_prompt_command},
	{"path",         check_path_entries},
	{"plugins",      check_plugins},
	{"backups",      check_backups},
	{"toml",         check_toml_config},
	{"turbo",        check_turbo_export},
	{"deps",         check_dependencies},
	{"sync",         check_sync_status},
}

// Check 1: wayu installation. Report-only: doctor never installs a binary
// (it used to symlink ./wayu from the current directory into /usr/local/bin).
check_wayu_installation :: proc(results: ^[dynamic]CheckResult) {
	ensure_arena_initialized()
	// Installed = reachable via $PATH (Homebrew, ~/.local/bin, ...).
	if !check_command_exists("wayu") {
		append(results, CheckResult{
			name    = clone_arena("wayu installation"),
			status  = .WARNING,
			message = clone_arena("wayu is not on PATH - add its directory to PATH, or run `./build_it install` from a wayu checkout"),
			fixable = false,
		})
		return
	}

	msg := fmt.aprintf("wayu %s installed", VERSION, allocator = get_doctor_allocator())
	append(results, CheckResult{
		name    = clone_arena("wayu installation"),
		status  = .OK,
		message = msg,
		fixable = false,
	})
}

// Strip `line` to its active shell code: "" for blank/comment lines, and a
// trailing ` # comment` removed (shell comments need preceding whitespace).
rc_active_code :: proc(line: string) -> string {
	trimmed := strings.trim_space(line)
	if len(trimmed) == 0 || trimmed[0] == '#' { return "" }
	for i in 1..<len(trimmed) {
		if trimmed[i] == '#' && (trimmed[i-1] == ' ' || trimmed[i-1] == '\t') {
			return strings.trim_space(trimmed[:i])
		}
	}
	return trimmed
}

// True when an active (non-comment) line of `content` loads wayu: it names
// wayu (any case, so `$WAYU/init.zsh` counts) and sources an init/turbo file
// or evals wayu output (`eval "$(wayu build eval)"`). With `turbo_only`,
// only a turbo.zsh / wayu-turbo reference counts.
rc_loads_wayu :: proc(content: string, turbo_only := false) -> bool {
	it := make_line_iter(content)
	for line in line_iter_next(&it) {
		code := rc_active_code(line)
		if len(code) == 0 { continue }
		lower := strings.to_lower(code, context.temp_allocator)
		if !strings.contains(lower, "wayu") { continue }
		if strings.contains(lower, "turbo") { return true }
		if turbo_only { continue }
		if strings.contains(lower, "init.") || strings.contains(lower, "eval") { return true }
	}
	return false
}

// 1-based numbers of the active lines AFTER the first line that loads wayu
// which overwrite bash's PROMPT_COMMAND without keeping its old value
// (`PROMPT_COMMAND=...` / `export PROMPT_COMMAND=...` / `declare ...` whose
// right-hand side doesn't mention PROMPT_COMMAND, or `unset PROMPT_COMMAND`).
// Such a line silently drops the `_wayu_paths_sync` prompt hook core.bash
// installs, so open shells stop picking up `wayu path add/rm`. `+=` appends
// and `PROMPT_COMMAND="x;$PROMPT_COMMAND"` keep it.
rc_prompt_command_overwrites :: proc(content: string, allocator := context.allocator) -> []int {
	out := make([dynamic]int, allocator)
	loaded := false
	n := 0
	it := make_line_iter(content)
	for line in line_iter_next(&it) {
		n += 1
		code := rc_active_code(line)
		if len(code) == 0 { continue }
		if !loaded {
			loaded = rc_loads_wayu(code)
			continue
		}
		if prompt_command_overwritten(code) { append(&out, n) }
	}
	return out[:]
}

@(private = "file")
prompt_command_overwritten :: proc(code: string) -> bool {
	NAME :: "PROMPT_COMMAND"
	rest := code
	for {
		i := strings.index(rest, NAME)
		if i < 0 { return false }
		before := rest[:i]
		after := rest[i+len(NAME):]
		rest = after
		// Must be a whole word (not MY_PROMPT_COMMAND / PROMPT_COMMANDS).
		if len(before) > 0 && doctor_is_ident_byte(before[len(before)-1]) { continue }
		if len(after) > 0 && doctor_is_ident_byte(after[0]) { continue }
		prev := strings.trim_right_space(before)
		if strings.has_suffix(prev, "unset") || strings.has_suffix(prev, "unset -v") { return true }
		if len(after) == 0 || after[0] != '=' { continue }
		// `NAME=` must start a word (assignment), not sit inside `$NAME=`.
		if len(before) > 0 && before[len(before)-1] == '$' { continue }
		if len(before) > 0 && before[len(before)-1] == '{' { continue }
		return !strings.contains(after[1:], NAME)
	}
}

// Startup files of the current shell (see shell_startup_files) that exist,
// and the first one that loads wayu ("" if none). With `turbo_only`, look
// for a turbo.zsh reference instead.
doctor_find_wayu_source :: proc(turbo_only := false) -> (found_in: string, existing: []string) {
	ensure_arena_initialized()
	alloc := get_doctor_allocator()
	present := make([dynamic]string, allocator = alloc)
	for f in shell_startup_files(wayu.shell, alloc) {
		if !os.exists(f) { continue }
		content, ok := safe_read_file(f)
		if !ok { continue }
		append(&present, f)
		if len(found_in) == 0 && rc_loads_wayu(string(content), turbo_only) {
			found_in = f
		}
		delete(content)
	}
	return found_in, present[:]
}

// `path` with a leading $HOME shown as `~` (for messages), or as `$HOME`
// with `home_var` (for shell code the user pastes inside double quotes).
doctor_tilde :: proc(path: string, home_var := false) -> string {
	home := os.get_env("HOME", context.temp_allocator)
	if len(home) > 0 && strings.has_prefix(path, home) {
		return fmt.aprintf("%s%s", home_var ? "$HOME" : "~", path[len(home):], allocator = get_doctor_allocator())
	}
	return path
}

// Check 2: shell configuration — wayu must be loaded from one of the
// shell's startup files (zsh: [$ZDOTDIR|~]/.zshenv .zprofile .zshrc .zlogin;
// bash: .bash_profile .bash_login .profile .bashrc; fish: config.fish +
// conf.d/*.fish).
check_shell_config :: proc(results: ^[dynamic]CheckResult) {
	ensure_arena_initialized()
	alloc := get_doctor_allocator()

	if wayu.shell == .UNKNOWN {
		append(results, CheckResult{
			name    = clone_arena("shell configuration"),
			status  = .WARNING,
			message = clone_arena("Could not determine your shell - pass --shell zsh|bash|fish"),
			fixable = false,
		})
		return
	}

	found_in, existing := doctor_find_wayu_source()
	if len(found_in) > 0 {
		append(results, CheckResult{
			name    = clone_arena("shell configuration"),
			status  = .OK,
			message = fmt.aprintf("wayu sourced in %s", doctor_tilde(found_in), allocator = alloc),
			fixable = false,
		})
		return
	}

	rc := doctor_tilde(get_rc_file_path(wayu.shell))
	if len(existing) == 0 {
		append(results, CheckResult{
			name    = clone_arena("shell configuration"),
			status  = .WARNING,
			message = fmt.aprintf("No %s startup file found (expected %s) - run 'wayu init'",
				get_shell_name(wayu.shell), rc, allocator = alloc),
			fixable = false,
		})
		return
	}

	shown := make([dynamic]string, allocator = alloc)
	for f in existing { append(&shown, doctor_tilde(f)) }
	append(results, CheckResult{
		name    = clone_arena("shell configuration"),
		status  = .ERROR,
		message = fmt.aprintf("wayu not sourced in %s - add 'source \"%s/init.%s\"' to %s",
			strings.join(shown[:], ", ", allocator = alloc), doctor_tilde(wayu.data, home_var = true),
			get_shell_extension(wayu.shell), rc, allocator = alloc),
		fixable = false,
	})
}

// bash only: warn when a startup file overwrites PROMPT_COMMAND after the
// line that loads wayu (see rc_prompt_command_overwrites). Silent when
// nothing is found, so other shells' output is unchanged.
check_bash_prompt_command :: proc(results: ^[dynamic]CheckResult) {
	if wayu.shell != .BASH { return }
	ensure_arena_initialized()
	alloc := get_doctor_allocator()
	hits := make([dynamic]string, allocator = alloc)
	for f in shell_startup_files(.BASH, alloc) {
		if !os.exists(f) { continue }
		content, ok := safe_read_file(f)
		if !ok { continue }
		for n in rc_prompt_command_overwrites(string(content), context.temp_allocator) {
			append(&hits, fmt.aprintf("%s:%d", doctor_tilde(f), n, allocator = alloc))
		}
		delete(content)
	}
	if len(hits) == 0 { return }
	append(results, CheckResult{
		name    = clone_arena("bash PROMPT_COMMAND"),
		status  = .WARNING,
		message = fmt.aprintf("%s replaces PROMPT_COMMAND after wayu is loaded, dropping the _wayu_paths_sync hook (open shells miss 'wayu path add/rm') - append instead: PROMPT_COMMAND=\"${{PROMPT_COMMAND:+$PROMPT_COMMAND;}}...\", or load wayu after it",
			strings.join(hits[:], ", ", allocator = alloc), allocator = alloc),
		fixable = false,
	})
}

// Check 3: PATH entries — read from wayu.toml [paths] (the source of truth),
// not the legacy path.<ext> file.
check_path_entries :: proc(results: ^[dynamic]CheckResult) {
	ensure_arena_initialized()
	arena_alloc := get_doctor_allocator()

	scan, scan_ok, skip_reason := doctor_scan_toml_paths(arena_alloc)
	if !scan_ok {
		append(results, CheckResult{
			name    = clone_arena("PATH entries"),
			status  = .INFO,
			message = clone_arena(skip_reason),
			fixable = false,
		})
		return
	}

	if len(scan) == 0 {
		append(results, CheckResult{
			name    = clone_arena("PATH entries"),
			status  = .INFO,
			message = clone_arena("No custom PATH entries configured"),
			fixable = false,
		})
		return
	}

	missing_count := 0
	duplicate_count := 0
	unresolved_count := 0
	for s in scan {
		if s.missing { missing_count += 1 }
		if s.duplicate { duplicate_count += 1 }
		if s.unresolved { unresolved_count += 1 }
	}
	unresolved_note := ""
	if unresolved_count > 0 {
		unresolved_note = fmt.aprintf("%d use%s unset variables or relative paths (left alone)",
			unresolved_count, unresolved_count == 1 ? "s" : "", allocator = arena_alloc)
	}

	if missing_count == 0 && duplicate_count == 0 {
		msg := fmt.aprintf("%d PATH entries, all valid", len(scan), allocator = arena_alloc)
		status := CheckStatus.OK
		if unresolved_count > 0 {
			msg = fmt.aprintf("%d PATH entries, %s", len(scan), unresolved_note, allocator = arena_alloc)
			status = .INFO
		}
		append(results, CheckResult{
			name    = clone_arena("PATH entries"),
			status  = status,
			message = msg,
			fixable = false,
		})
	} else {
		msg_parts := make([dynamic]string, allocator = arena_alloc)
		if missing_count > 0 {
			append(&msg_parts, fmt.aprintf("%d missing", missing_count, allocator = arena_alloc))
		}
		if duplicate_count > 0 {
			append(&msg_parts, fmt.aprintf("%d duplicates", duplicate_count, allocator = arena_alloc))
		}
		if unresolved_count > 0 {
			append(&msg_parts, unresolved_note)
		}

		msg := fmt.aprintf("%d PATH entries, %s - run 'wayu doctor --fix --yes' (or 'wayu path clean' / 'wayu path dedup')",
			len(scan), strings.join(msg_parts[:], ", ", allocator = arena_alloc), allocator = arena_alloc)
		append(results, CheckResult{
			name    = clone_arena("PATH entries"),
			status  = .WARNING,
			message = msg,
			fixable = true,
		})
	}
}

// One [paths] entry plus its health verdict.
DoctorPathScan :: struct {
	entry:      TomlPathEntry,
	missing:    bool, // directory doesn't exist (after $VAR / ~ expansion)
	duplicate:  bool, // expands to the same dir as an earlier entry
	unresolved: bool, // uses a variable set neither in wayu.toml [env] nor the environment, or is relative (cwd-dependent)
}

@(private = "file")
doctor_is_ident_byte :: proc(c: byte) -> bool {
	return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_'
}

// Expand `path` the way the generated shell init does: wayu.toml [env]
// constants first (core exports them before PATH), then the environment,
// then a leading `~`. Returns "" when any variable stays unresolved — such an
// entry's existence is unknown, so it must never be classed as missing.
doctor_expand_path :: proc(path: string, consts: []ConfigEntry) -> string {
	b := strings.builder_make()
	defer strings.builder_destroy(&b) // expand_env_vars returns a fresh string
	i := 0
	for i < len(path) {
		if path[i] != '$' {
			strings.write_byte(&b, path[i])
			i += 1
			continue
		}
		start := i
		i += 1
		name: string
		if i < len(path) && path[i] == '{' {
			name_start := i + 1
			end := strings.index_byte(path[name_start:], '}')
			if end < 0 {
				strings.write_string(&b, path[start:])
				break
			}
			name = path[name_start:name_start + end]
			i = name_start + end + 1
		} else {
			name_start := i
			for i < len(path) && doctor_is_ident_byte(path[i]) { i += 1 }
			name = path[name_start:i]
		}
		replaced := false
		for c in consts {
			if c.name == name && len(name) > 0 {
				strings.write_string(&b, c.value)
				replaced = true
				break
			}
		}
		if !replaced { strings.write_string(&b, path[start:i]) }
	}
	// A relative entry (`./node_modules/.bin`, `bin`) is resolved by the
	// shell against whatever directory it is in, so its existence depends on
	// doctor's cwd: treat it as unresolved, never as missing (--fix would
	// delete it).
	s := strings.to_string(b)
	if len(s) == 0 || (s[0] != '/' && s[0] != '~' && s[0] != '$') { return "" }
	return expand_env_vars(s, require_resolved = true)
}

// Read wayu.toml [paths] and classify each entry. Never exits: a missing or
// legacy-schema wayu.toml is reported via ok=false + reason (the TOML check
// surfaces the actual problem). All memory comes from `alloc`.
doctor_scan_toml_paths :: proc(alloc: mem.Allocator) -> (scan: [dynamic]DoctorPathScan, ok: bool, reason: string) {
	context.allocator = alloc

	toml_path := fmt.aprintf("%s/%s", wayu.config, WAYU_TOML)
	if !os.exists(toml_path) {
		return nil, false, "No wayu.toml — PATH check skipped"
	}
	content, read_ok := safe_read_file(toml_path)
	if !read_ok {
		return nil, false, "Cannot read wayu.toml — PATH check skipped"
	}
	if len(detect_legacy_schema(string(content))) > 0 {
		return nil, false, "wayu.toml uses the obsolete schema — PATH check skipped"
	}

	// toml_path_read_keyed may serve a cached copy; make sure it's fresh.
	clear_toml_content_cache()
	entries := toml_path_read_keyed()
	consts := read_wayu_toml_constants()
	// Don't leave arena-owned memory in the global cache once doctor returns.
	defer clear_toml_content_cache()

	scan = make([dynamic]DoctorPathScan, 0, len(entries))
	seen := make(map[string]bool)
	for e in entries {
		s := DoctorPathScan{entry = e}
		expanded := doctor_expand_path(e.path, consts)
		if len(expanded) == 0 {
			s.unresolved = true
			append(&scan, s)
			continue
		}
		s.missing = !os.exists(expanded)
		if expanded in seen {
			s.duplicate = true
		}
		seen[expanded] = true
		append(&scan, s)
	}
	return scan, true, ""
}

// --fix for PATH: drop missing + duplicate entries from wayu.toml [paths]
// with a single backup and a single rewrite, then regenerate the shell init.
// Returns (removed_count, ok, message).
doctor_fix_toml_paths :: proc(alloc: mem.Allocator) -> (removed: int, ok: bool, message: string) {
	context.allocator = alloc

	// Scan and rewrite under one lock so the fix acts on what is on disk.
	if !config_lock_acquire() {
		return 0, false, "Could not lock wayu config — nothing changed"
	}
	defer config_lock_release()

	scan, scan_ok, reason := doctor_scan_toml_paths(alloc)
	if !scan_ok {
		return 0, false, reason
	}

	drop_keys := make([dynamic]string)
	for s in scan {
		if s.missing || s.duplicate {
			removed += 1
			reason_word := s.missing ? "missing" : "duplicate"
			fmt.printfln("    - %s = %q (%s)", s.entry.key, s.entry.path, reason_word)
			append(&drop_keys, s.entry.key)
		}
	}
	if removed == 0 {
		return 0, true, "Nothing to remove"
	}

	// The rewrite deletes every line of a key. If a key to drop also names
	// an entry that stays (a repeated key: `a = "/x"` twice), deleting it
	// would remove the survivor too — refuse and change nothing.
	for s in scan {
		if s.missing || s.duplicate { continue }
		for k in drop_keys {
			if k != s.entry.key { continue }
			print_error("wayu.toml [paths] defines key '%s' more than once — --fix would delete every line of it. Rename or remove the repeated key by hand; nothing changed.", k)
			os.exit(EXIT_CONFIG)
		}
	}

	if wayu.dry_run {
		return removed, true, fmt.aprintf("DRY RUN: would remove %d entr%s from wayu.toml [paths]",
			removed, removed == 1 ? "y" : "ies")
	}

	// One backup, one in-place deletion of just the dropped lines: the
	// survivors keep their order (PATH precedence) and comments.
	switch toml_kv_delete("paths", "paths", drop_keys[:]) {
	case .OK:
	case .MALFORMED: return 0, false, "wayu.toml [paths] is malformed — nothing changed"
	case .NOT_FOUND: return 0, false, "PATH entries changed during the fix — nothing changed"
	case .IO_ERROR:  return 0, false, "Could not back up or write wayu.toml"
	}
	regenerate_init_core_silently()

	return removed, true, fmt.aprintf("Removed %d missing/duplicate entr%s from wayu.toml",
		removed, removed == 1 ? "y" : "ies")
}

// Check 4: plugins
check_plugins :: proc(results: ^[dynamic]CheckResult) {
	ensure_arena_initialized()
	config_file := fmt.aprintf("%s/plugins.json", wayu.data, allocator = get_doctor_allocator())

	if !os.exists(config_file) {
		append(results, CheckResult{
			name    = clone_arena("plugins"),
			status  = .INFO,
			message = clone_arena("No plugins configured"),
			fixable = false,
		})
		return
	}

	data, ok := safe_read_file(config_file)
	if !ok {
		append(results, CheckResult{
			name    = clone_arena("plugins"),
			status  = .WARNING,
			message = clone_arena("Could not read plugins configuration"),
			fixable = false,
		})
		return
	}
	defer delete(data)

	content := string(data)
	plugin_count := strings.count(content, "\"name\"")

	if plugin_count == 0 {
		append(results, CheckResult{
			name    = clone_arena("plugins"),
			status  = .INFO,
			message = clone_arena("No plugins installed"),
			fixable = false,
		})
	} else {
		msg := fmt.aprintf("%d plugin(s) installed", plugin_count, allocator = get_doctor_allocator())
		append(results, CheckResult{
			name    = clone_arena("plugins"),
			status  = .OK,
			message = msg,
			fixable = false,
		})
	}
}

// Check 5: backups
check_backups :: proc(results: ^[dynamic]CheckResult) {
	ensure_arena_initialized()
	backup_dir := fmt.aprintf("%s/backup", wayu.data, allocator = get_doctor_allocator())

	if !os.exists(backup_dir) {
		append(results, CheckResult{
			name    = clone_arena("backups"),
			status  = .WARNING,
			message = clone_arena("Backup directory not found"),
			fixable = false,
		})
		return
	}

	append(results, CheckResult{
		name    = clone_arena("backups"),
		status  = .OK,
		message = clone_arena("Backup system configured"),
		fixable = false,
	})
}

// Check 6: TOML config
check_toml_config :: proc(results: ^[dynamic]CheckResult) {
	ensure_arena_initialized()
	toml_path := fmt.aprintf("%s/wayu.toml", wayu.config, allocator = get_doctor_allocator())

	if !os.exists(toml_path) {
		append(results, CheckResult{
			name    = clone_arena("TOML config"),
			status  = .INFO,
			message = clone_arena("No TOML configuration (using standard shell configs)"),
			fixable = false,
		})
		return
	}

	// Try to validate - just check if we can read it
	content, ok := safe_read_file(toml_path)
	if !ok {
		append(results, CheckResult{
			name    = clone_arena("TOML config"),
			status  = .ERROR,
			message = clone_arena("Cannot read wayu.toml"),
			fixable = false,
		})
		return
	}
	defer delete(content)

	// Schema sanity — if the file still uses [[paths]]/[[aliases]]/[[constants]],
	// every other wayu command will refuse to run. Surface that here.
	if header := detect_legacy_schema(string(content)); len(header) > 0 {
		msg := fmt.aprintf("wayu.toml uses obsolete %s schema — run `wayu migrate --schema`", header)
		defer delete(msg)
		append(results, CheckResult{
			name    = clone_arena("TOML config"),
			status  = .ERROR,
			message = clone_arena(msg),
			fixable = false,
		})
		return
	}

	// Actually validate: syntax sanity + full parse. Previously any readable
	// file was reported OK, so a corrupt wayu.toml passed the health check.
	if !toml_content_is_sane(string(content)) {
		append(results, CheckResult{
			name    = clone_arena("TOML config"),
			status  = .ERROR,
			message = clone_arena("wayu.toml is malformed (invalid TOML syntax) — run `wayu validate` or restore with `wayu backup restore toml --yes`"),
			fixable = false,
		})
		return
	}
	if _, parse_ok := toml_parse(string(content)); !parse_ok {
		append(results, CheckResult{
			name    = clone_arena("TOML config"),
			status  = .ERROR,
			message = clone_arena("wayu.toml could not be parsed — run `wayu validate`"),
			fixable = false,
		})
		return
	}

	append(results, CheckResult{
		name    = clone_arena("TOML config"),
		status  = .OK,
		message = clone_arena("wayu.toml is valid"),
		fixable = false,
	})
}

// Check 7: turbo export. turbo.zsh is optional; it only matters when a
// startup file sources it. Report-only: doctor never generates it.
check_turbo_export :: proc(results: ^[dynamic]CheckResult) {
	ensure_arena_initialized()
	turbo_path := fmt.aprintf("%s/turbo.zsh", wayu.data, allocator = get_doctor_allocator())
	exists := os.exists(turbo_path)
	referenced_in, _ := doctor_find_wayu_source(turbo_only = true)
	referenced := len(referenced_in) > 0

	status := CheckStatus.OK
	msg := "Turbo export generated and active"
	switch {
	case !exists && referenced:
		status = .ERROR
		msg = fmt.aprintf("%s sources turbo.zsh but it is not generated - run 'wayu export'",
			doctor_tilde(referenced_in), allocator = get_doctor_allocator())
	case !exists:
		msg = "Not in use (optional: 'wayu export' writes a single-file turbo init)"
	case !referenced:
		status = .INFO
		msg = "turbo.zsh exists but no startup file sources it (unused; safe to delete)"
	}
	append(results, CheckResult{
		name    = clone_arena("turbo export"),
		status  = status,
		message = clone_arena(msg),
		fixable = false,
	})
}

// Check 8: dependencies
check_dependencies :: proc(results: ^[dynamic]CheckResult) {
	ensure_arena_initialized()
	deps := []string{"git", "zsh"}
	arena_alloc := get_doctor_allocator()

	for dep in deps {
		found := check_command_exists(dep)

		name := fmt.aprintf("dependency: %s", dep, allocator = arena_alloc)
		if found {
			msg := fmt.aprintf("%s found", dep, allocator = arena_alloc)
			append(results, CheckResult{
				name    = name,
				status  = .OK,
				message = msg,
				fixable = false,
			})
		} else {
			msg := fmt.aprintf("%s not found in common paths", dep, allocator = arena_alloc)
			append(results, CheckResult{
				name    = name,
				status  = .WARNING,
				message = msg,
				fixable = false,
			})
		}
	}
}

// Check if a command exists in PATH (helper for check_dependencies).
check_command_exists :: proc(cmd: string) -> bool {
	// Delegate to the canonical PATH-aware lookup (shell.odin) so there is a
	// single source of truth for "is this command installed". The previous
	// hardcoded 4-path scan missed anything outside /usr/bin, /bin,
	// /usr/local/bin, /opt/homebrew/bin.
	return command_exists(cmd)
}

// Check 9: sync status — wayu entries vs environment
check_sync_status :: proc(results: ^[dynamic]CheckResult) {
	ensure_arena_initialized()
	arena_alloc := get_doctor_allocator()

	// Only run this check if wayu is initialized
	toml_file := fmt.aprintf("%s/%s", wayu.config, WAYU_TOML)
	defer delete(toml_file)

	if !os.exists(toml_file) {
		// wayu not initialized yet - skip sync check
		return
	}

	found_in, _ := doctor_find_wayu_source()

	sync_msg := ""
	sync_status := CheckStatus.OK
	if len(found_in) > 0 {
		sync_msg = clone_arena("All wayu entries are loaded in current shell")
	} else {
		sync_msg = clone_arena("wayu is not loaded by any startup file - see 'shell configuration' above")
		sync_status = .WARNING
	}

	append(results, CheckResult{
		name    = clone_arena("Sync status"),
		status  = sync_status,
		message = sync_msg,
		fixable = false,
	})
}
