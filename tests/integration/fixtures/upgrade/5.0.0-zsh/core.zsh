#!/usr/bin/env zsh
# core.zsh - ESSENTIAL (< 10ms)
# Auto-generated by wayu build

# === Environment (from wayu.toml [env]) ===
export EDITOR="nvim"
export GREETING="hello world"
export PROJECTS="$HOME/projects"

# === PATH (from wayu.toml [paths], live-synced at each prompt) ===
_wayu_paths_apply() {
  emulate -L zsh
  local first=0 d prev="" i
  [[ -n "${_WAYU_PATHS_SIG-}" ]] || first=1
  typeset -g _WAYU_PATHS_SIG="# wayu-paths $1"
  shift
  local -a want keep managed old=( ${(s.:.)${_WAYU_PATHS_MANAGED-}} )
  for d in "$@"; do
    [[ -n $d && $d != *:* && $d != *$'\n'* && -d $d ]] || continue
    (( ${want[(Ie)$d]} )) || want+=( "$d" )
  done
  for d in $want; do
    (( ${old[(Ie)$d]} || ! ${path[(Ie)$d]} )) && managed+=( "$d" )
  done
  for d in $path; do
    (( ${old[(Ie)$d]} && ! ${want[(Ie)$d]} )) && continue
    (( first && ${want[(Ie)$d]} )) && continue
    (( ${keep[(Ie)$d]} )) || keep+=( "$d" )
  done
  if (( first )); then
    keep=( $want $keep )
  else
    for d in $want; do
      if (( ! ${keep[(Ie)$d]} )); then
        if [[ -z $prev ]]; then
          keep=( "$d" $keep )
        else
          i=${keep[(Ie)$prev]}
          keep=( "${(@)keep[1,i]}" "$d" "${(@)keep[i+1,-1]}" )
        fi
      fi
      prev=$d
    done
  fi
  path=( $keep )
  typeset -gx _WAYU_PATHS_MANAGED="${(j.:.)managed}"
  export PATH
}
_wayu_paths_sync() {
  local s=$? l
  if [[ ${_WAYU_PATHS_REGEN-1} == 1 && -n ${_WAYU_TOML_FILE-} && $_WAYU_TOML_FILE -nt $_WAYU_PATHS_FILE ]]; then
    command "${_WAYU_BIN:-wayu}" build </dev/null >/dev/null 2>&1
    [[ $_WAYU_TOML_FILE -nt $_WAYU_PATHS_FILE ]] && typeset -g _WAYU_PATHS_REGEN=0
  fi
  { read -r l < "$_WAYU_PATHS_FILE" } 2>/dev/null || return $s
  [[ "$l" == "${_WAYU_PATHS_SIG-}" ]] || source "$_WAYU_PATHS_FILE"
  return $s
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _wayu_paths_sync
_WAYU_PATHS_FILE="@HOME@/.config/wayu/path_sync.zsh"
_WAYU_BIN="@WAYU_BIN@"
_WAYU_TOML_FILE="@HOME@/.config/wayu/wayu.toml"
if [ -f "$_WAYU_PATHS_FILE" ]; then . "$_WAYU_PATHS_FILE"; fi
# Deduplicate PATH (preserve order, remove duplicates)
typeset -U path PATH

# === Completions ===
fpath=("@HOME@/.config/wayu/completions" "${fpath[@]}")
() {
  emulate -L zsh
  local dump="${ZDOTDIR:-$HOME}/.zcompdump"
  autoload -Uz compinit
  if [[ ! -s $dump || "@HOME@/.config/wayu/completions" -nt $dump ]]; then
    command rm -f -- "$dump" "$dump.zwc"
    compinit -u -d "$dump"
  else
    compinit -C -d "$dump"
  fi
}

# === Functions ===
() { emulate -L zsh; typeset -ga _wayu_fn_files; _wayu_fn_files=( "@HOME@/.config/wayu/functions"/*(N-.) ) }
for _wayu_f in "${_wayu_fn_files[@]}"; do source "$_wayu_f"; done
unset _wayu_f _wayu_fn_files

# === Load helpers ===
source "@HOME@/.config/wayu/helpers.zsh" 2>/dev/null || true

# === Plugins ===
if [ -f "@HOME@/.config/wayu/plugins.zsh" ]; then source "@HOME@/.config/wayu/plugins.zsh"; fi
if (( ! ${+functions[_zsh_autosuggest_start]} )) && [ -f "@HOME@/.config/wayu/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then source "@HOME@/.config/wayu/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"; fi
if [ -f "@HOME@/.config/wayu/plugins/config.zsh" ]; then source "@HOME@/.config/wayu/plugins/config.zsh"; fi
if (( ! ${+functions[_zsh_highlight]} )) && [ -f "@HOME@/.config/wayu/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then source "@HOME@/.config/wayu/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"; fi

# === Lazy init (tools, extra config) ===
source "@HOME@/.config/wayu/lazy.zsh"

# === Aliases (from wayu.toml [aliases]) ===
alias gs='git status --short'
alias ll='ls -la'
alias q='echo "it'\''s quoted"'

