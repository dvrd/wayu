#!/usr/bin/env fish
# core.fish - generated by wayu

# === Environment (from wayu.toml [env]) ===
set -gx EDITOR "nvim"
set -gx GREETING "hello world"
set -gx PROJECTS "$HOME/projects"

# === PATH ===
if test -d '@HOME@/bin dir'; and not string match -q -- '*:*' '@HOME@/bin dir'; and not contains -- '@HOME@/bin dir' $PATH
    set -gx PATH '@HOME@/bin dir' $PATH
end
if test -d '@HOME@/tools'; and not string match -q -- '*:*' '@HOME@/tools'; and not contains -- '@HOME@/tools' $PATH
    set -gx PATH '@HOME@/tools' $PATH
end

# === Aliases (from wayu.toml [aliases]) ===
alias gs 'git status --short'
alias ll 'ls -la'
alias q 'echo "it\'s quoted"'

# === Completions ===
set -p fish_complete_path '@HOME@/.config/wayu/completions'

# === Plugins ===
if test -f '@HOME@/.config/wayu/plugins.fish'
    source '@HOME@/.config/wayu/plugins.fish'
end

