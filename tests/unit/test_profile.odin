// test_profile.odin - `wayu build profile` unit splitting (OKAMI-180)

package test_wayu

import "core:fmt"
import "core:os"
import "core:testing"
import wayu "../../src"

// core.zsh is split per section and per [tools] entry; the plugins source
// line is replaced by plugins.zsh, split per plugin; non-recipe `# --- … ---`
// markers name a sub-unit of their section; comment-only units are dropped
// and every code line lands in exactly one unit.
@(test)
test_profile_core_units_split_tools_and_plugins :: proc(t: ^testing.T) {
	tmp := test_tmp("wayu_test_profile_units")
	os.remove_all(tmp)
	testing.expect(t, os.make_directory(tmp) == nil)
	defer os.remove_all(tmp)

	saved_data := wayu.wayu.data
	wayu.wayu.data = tmp
	defer wayu.wayu.data = saved_data

	plugins := "#!/usr/bin/env zsh\n# Auto-generated by wayu - DO NOT EDIT\n\n# Load enabled plugins\n\n" +
		"# alpha (priority: 100, template: source)\nif [ -f '/p/alpha.zsh' ]; then\n    source '/p/alpha.zsh'\nfi\n\n" +
		"# beta (priority: 200, template: source)\nif [ -f '/p/beta.zsh' ]; then\n    source '/p/beta.zsh'\nfi\n\n# End of plugin loading\n"
	testing.expect(t, wayu.safe_write_file(fmt.tprintf("%s/plugins.zsh", tmp), transmute([]byte)plugins))

	core := fmt.tprintf("#!/usr/bin/env zsh\n# core.zsh\n\n# === Environment (from wayu.toml [env]) ===\nexport A=1\n\n" +
		"# === Tools (eager - keybindings, immediate) ===\n_wayu_evalcache atuin 'init' 'zsh'\n\n" +
		"# === Plugins ===\nif [ -f \"%s/plugins.zsh\" ]; then source \"%s/plugins.zsh\"; fi\nbindkey x y\n\n" +
		"# === Prompt (wayu native, interactive shells) ===\n# --- vi mode ---\nbindkey -v\n\n" +
		"# === Tools (deferred) ===\n_wayu_evalcache zoxide 'init' 'zsh'\n" +
		"# --- recipe: nvm (lazy) ---\nnvm() { :; }\n# --- recipe: lazy (sdk) ---\nsdk() { :; }\n\n# === Extra config ===\necho extra\n\n" +
		"# === Aliases (from wayu.toml [aliases]) ===\nalias ll='ls'\n",
		tmp, tmp)

	units := wayu.profile_core_units(core, .ZSH)
	defer {
		for u in units { delete(u.name); delete(u.body) }
		delete(units)
	}
	want := []string{
		"Environment (from wayu.toml [env])",
		"tool atuin (evalcache)",
		"plugin alpha",
		"plugin beta",
		"Plugins",
		"Prompt (wayu native, interactive shells) › vi mode",
		"tool zoxide (evalcache)",
		"tool nvm (lazy)",
		"tool sdk (lazy)",
		"Extra config",
		"Aliases (from wayu.toml [aliases])",
	}
	names := make([dynamic]string, context.temp_allocator)
	for u in units { append(&names, u.name) }
	testing.expectf(t, len(units) == len(want), "units %v", names[:])
	if len(units) != len(want) { return }
	for w, i in want {
		testing.expectf(t, units[i].name == w, "unit %d: %q, want %q", i, units[i].name, w)
	}
	testing.expect(t, units[4].body == "bindkey x y\n\n", "core text after the inlined loader stays in its section")
}
